  "cards": [
    {
      "dot": "cyan",
      "title": "采集与切段",
      "items": [
        "解析依次走 TikTok webcast 接口 → yt-dlp → 借浏览器登录态 → 直播页兜底",
        "webcast 接口给的是 only_audio 纯音频档，省掉整条视频码流",
        "ffmpeg 先 highpass=70 再 arnndn 神经降噪，专门压直播的背景音乐"
      ]
    },
    {
      "dot": "amber",
      "title": "两级背压，方向相反",
      "items": [
        "音频队列按秒计，到 60 s 硬顶才丢最旧一段——识别慢只推迟报警，不该漏词",
        "翻译队列 maxsize=4，满了立刻丢最旧任务，绝不反压回识别链路",
        "被丢的音频段与翻译任务都进审计日志，事后能区分漏听和漏译"
      ]
    },
    {
      "dot": "rose",
      "title": "报警链路不依赖翻译",
      "items": [
        "违禁词扫的是 raw_text，含被质量过滤丢掉的部分——宁可多报，不能漏报",
        "三级匹配：原样命中、形态变化、ASR 听错一两个字母的模糊层",
        "识别一出结果就推原文并扫词，译文后到再回填字幕"
      ]
    }
  ]
