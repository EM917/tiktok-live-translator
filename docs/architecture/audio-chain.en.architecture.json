  "cards": [
    {
      "dot": "cyan",
      "title": "Capture & segment",
      "items": [
        "Resolves via up to 7 layers: login-first page (macOS) → live API → login retry → WebKit (macOS) → yt-dlp → yt-dlp+login → page fallback",
        "Every layer prefers the only_audio rendition; ffmpeg runs highpass=70 then arnndn against background music",
        "Start and Switch Streamer share one path: stop the last session, re-read the term lists, open a new audit, resolve again"
      ]
    },
    {
      "dot": "emerald",
      "title": "Captions first",
      "items": [
        "The source caption ships as soon as ASR returns; the translation fills the same line in by id",
        "The glossary merges global → brand → streamer and feeds ASR hotwords, translation hints and fix-ups",
        "Interface text turns Chinese or English only at the edge; terminal, logs and audit stay Chinese"
      ]
    },
    {
      "dot": "amber",
      "title": "Backpressure & alerts",
      "items": [
        "Audio is budgeted in seconds and dropped only at a 60 s cap; the translation queue drops its oldest job at 4 rather than stall ASR",
        "The scan reads raw_text (incl. filtered text) and never waits on translation; with alerts off (the default) hits go to the audit only",
        "Startup Check exercises each link; a failure stays in the top banner while live"
      ]
    }
  ]
