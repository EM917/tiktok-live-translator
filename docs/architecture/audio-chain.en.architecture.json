  "cards": [
    {
      "dot": "cyan",
      "title": "Capture & segment",
      "items": [
        "Resolves via webcast API → yt-dlp → browser login → live-page fallback",
        "The webcast API returns an only_audio rendition, skipping the video bitstream",
        "highpass=70 then arnndn, tuned for streams with constant background music"
      ]
    },
    {
      "dot": "amber",
      "title": "Backpressure, two directions",
      "items": [
        "Audio is budgeted in seconds; only a 60 s hard cap drops the oldest segment",
        "Translation queue is maxsize=4 and drops the oldest job rather than stalling ASR",
        "Both kinds of drop reach the audit log: missed audio vs missed translation"
      ]
    },
    {
      "dot": "rose",
      "title": "Alerts never wait on translation",
      "items": [
        "Scans raw_text, including quality-filtered text: over-report beats under-report",
        "Three tiers: literal, morphological variant, and fuzzy for ASR mishearing",
        "Caption and alert ship as soon as ASR returns; translation is filled in later"
      ]
    }
  ]
