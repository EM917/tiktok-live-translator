.venv/
.venv.lock
settings.json
# app/settings.py 写 settings.json 时的临时文件，以及读到损坏文件时改名留下的备份
# （settings.json.corrupt-<时间>[-n]）。里面是整份设置，含 Claude/DeepL 密钥——
# 和 settings.json 一样不入库，也不能挡住一键更新（工作区要保持干净）
settings.json.tmp
settings.json.corrupt-*
__pycache__/
*.pyc
.DS_Store
# RNNoise 模型由 setup.sh / setup.ps1 下载（来自 GregorR/rnnoise-models）
models/
# 用户自己的违禁词表（模板见 banned_terms.example.txt）——不入库，
# 以免用户编辑后工作区变脏、挡住一键更新
banned_terms.txt
# 用户自己的领域词表（模板见 glossary.example.txt）
glossary.txt
# 用户自己的主播专属词表（模板见 profiles/*.example.txt）
profiles/*.txt
!profiles/*.example.txt
# 用户自己的品牌词表副本（模板见 brands/*.example.txt），机制同上
brands/*.txt
!brands/*.example.txt
# 审计日志
logs/
# 识别证据音频（app/asr_evidence.py）：直播混音的 WAV 片段和它们的索引，在 logs/ 底下，
# 上一行已经盖住；单独再写一遍，免得以后有人把证据目录挪出 logs/ 时漏掉——它绝不能进仓库
logs/asr-evidence/
# 字幕记录：每场的字幕、译文和观众弹幕（含昵称），以及导出的 .md/.csv/.srt——个人数据，不入库
transcripts/
# 用户/程序在目录里留下的杂物——它们不入库，也绝不该挡住一键更新
*.bak
*.bak-*
*.log
.run.log
# .app 里的 venv 外壳：含本机路径，由 app/macbundle.py 启动时生成
TikTok Live Translator.app/Contents/pyvenv.cfg
TikTok Live Translator.app/Contents/lib
# 弹幕留意：用户自己的叠加词表、关注名单、本地模型实测记录、留存样本——个人数据，不入库
# （说明在 comment_guard/README.md，默认词表在 comment_guard/defaults/，都入库）
comment_guard/local/
comment_guard/marked/
comment_guard/bench/
comment_guard/retained/
