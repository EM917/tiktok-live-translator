     "state": {"running": true, "paused_reason": null}, "expect": true},
    {"why": "1 号位，闪购助手故意不续开",
     "product": {"id": "1000000000000000003", "state": "stopped", "enabled": true, "skip": "slot_1"},
     "state": {"running": true, "paused_reason": null}, "expect": false},
    {"why": "没有库存，不续开",
     "product": {"id": "1000000000000000003", "state": "stopped", "enabled": true, "skip": "no_stock"},
     "state": {"running": true, "paused_reason": null}, "expect": false},
    {"why": "认不出的 skip 代码也算故意不续开",
     "product": {"id": "1000000000000000003", "state": "stopped", "enabled": true, "skip": "brand_new_reason"},
     "state": {"running": true, "paused_reason": null}, "expect": false},
    {"why": "关了自动续开",
     "product": {"id": "1000000000000000003", "state": "stopped", "enabled": false, "skip": null},
     "state": {"running": true, "paused_reason": null}, "expect": false},
    {"why": "enabled 读不出：只认 true",
     "product": {"id": "1000000000000000003", "state": "stopped", "enabled": null, "skip": null},
     "state": {"running": true, "paused_reason": null}, "expect": false},
    {"why": "不是 stopped",
     "product": {"id": "1000000000000000004", "state": "pending", "enabled": true, "skip": null},
     "state": {"running": true, "paused_reason": null}, "expect": false},
    {"why": "闪购助手没在运行",
