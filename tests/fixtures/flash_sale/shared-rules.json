       {"id": "a", "state": "live", "stuck": false, "position": 5},
       {"id": "b", "state": "live", "stuck": false, "position": null},
       {"id": "c", "state": "live", "stuck": false, "position": 2},
       {"id": "d", "state": "pending", "stuck": false, "position": 9},
