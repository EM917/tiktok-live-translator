#!/usr/bin/env bash
# macOS 应用启动器：.app 位于项目根目录，向上三级即项目根。
# 由 Finder 启动时没有终端、PATH 也只有系统目录，所以 Python 必须按安装位置
# 逐个探测，出问题时用系统对话框说话（print 没人看得见）。
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"

dialog() {  # $1=文本 $2=图标（note/caution，默认 note）
  osascript -e "display dialog \"$1\" with title \"TikTok 直播同传\" buttons {\"好\"} default button 1 with icon ${2:-note}" >/dev/null 2>&1
}

if [ ! -f "$DIR/main.py" ]; then
  dialog "找不到程序文件。\n\n请把「TikTok Live Translator」放回 tiktok-live-translator 文件夹里再双击。想常驻可以把它拖到 Dock——但不要把它拖出文件夹。" caution
  exit 1
fi
cd "$DIR"

# find_python() 和 Start.command 共用一份，见 tools/find_python.sh。
if [ ! -f "$DIR/tools/find_python.sh" ]; then
  dialog "缺少程序文件 tools/find_python.sh，项目文件不完整，无法探测 Python。\n\n请把「TikTok Live Translator」放回 tiktok-live-translator 文件夹里再双击，或重新下载完整项目。" caution
  exit 1
fi
. "$DIR/tools/find_python.sh"

PY="$(find_python)" || {
  open "https://www.python.org/downloads/"
  dialog "需要先安装 Python 才能运行本工具（免费，约 2 分钟）。\n\n已为你打开下载页面 python.org/downloads——下载 macOS 安装包并安装，装好后重新双击启动即可。"
  exit 1
}

exec "$PY" main.py
